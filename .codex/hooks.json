{
  "description": "Project-local Codex hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/harness/file_size_hint.py\"",
            "timeout": 5
          }
        ],
        "matcher": "^apply_patch$"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/harness/file_size_hint.py\"",
            "timeout": 5
          }
        ],
        "matcher": "^apply_patch$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/harness/handoff.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
