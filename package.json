{
  "name": "@limchihi/harness",
  "version": "0.1.1",
  "description": "Project-local development harness for coding agents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "harness": "bin/harness.js"
  },
  "files": [
    "bin/",
    "hooks/file_size_hint.py",
    "skills/imp/SKILL.md",
    "skills/imp/agents/openai.yaml",
    "skills/imp/scripts/start.py",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/installer.test.js && python3 -m unittest discover -s tests -p 'test_*.py'",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LimChihi/harness.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
